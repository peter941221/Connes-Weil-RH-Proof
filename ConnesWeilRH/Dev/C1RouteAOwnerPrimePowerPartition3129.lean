import ConnesWeilRH.Dev.C1RouteAJointSymbolData3080
import Mathlib.Algebra.IsPrimePow
import Mathlib.NumberTheory.ArithmeticFunction.VonMangoldt

/-!
# Route A owner prime-power partition

This module proves the arithmetic partition needed before pricing the
owner-specific residual.  It keeps the actual finite owner set separate from
the larger prime-power closure generated by Route A's visible primes.
No equality of the two sets, residual sign, or residual bound is asserted.
-/

namespace ConnesWeilRH
namespace Source
namespace C1RouteAOwnerPrimePowerPartition3129

open C1G8R0OrbitGeometry
open C1P2SignedBudget
open C1RouteAJointSymbolData3080
open C1SameOwnerWeil
open CC20YoshidaConvolution
open CC20YoshidaConvolution.CompactLogTest
open CC20YoshidaNearZeros
open CCM25Concrete.CompactLogConvolution
open scoped BigOperators

noncomputable section

def routeAPrimePowerClosure
    {rho : sourceNontrivialZeroSet} {g : CompactLogTest}
    (geometry : OrbitG8Geometry rho g) : Set ℕ :=
  {q | ∃ p ∈ routeAVisiblePrimes geometry, ∃ k : ℕ, p ^ (k + 1) = q}

def routeAPrimePowerClosureWithinCutoff
    {rho : sourceNontrivialZeroSet} {g : CompactLogTest}
    (geometry : OrbitG8Geometry rho g) : Finset ℕ :=
  by
    classical
    exact (orbitVisiblePrimeRange geometry).filter fun q =>
      q ∈ routeAPrimePowerClosure geometry

def routeAOwnerMissingWithinCutoff
    {rho : sourceNontrivialZeroSet} {g : CompactLogTest}
    (geometry : OrbitG8Geometry rho g) : Finset ℕ :=
  by
    classical
    exact (routeAPrimePowerClosureWithinCutoff geometry).filter fun q =>
      q ∉ globalPrimeIndexSet g.convolutionSquare

def routeAOwnerPrimePowerTail
    {rho : sourceNontrivialZeroSet} {g : CompactLogTest}
    (geometry : OrbitG8Geometry rho g) : Set ℕ :=
  routeAPrimePowerClosure geometry \ (orbitVisiblePrimeRange geometry : Set ℕ)

theorem vonMangoldt_primePower_eq_log
    (p k : ℕ) (hp : p.Prime) :
    ArithmeticFunction.vonMangoldt (p ^ (k + 1)) = Real.log p := by
  rw [ArithmeticFunction.vonMangoldt_apply_pow (Nat.succ_ne_zero k),
    ArithmeticFunction.vonMangoldt_apply_prime hp]

theorem actualOwner_mem_cutoff
    {rho : sourceNontrivialZeroSet} {g : CompactLogTest}
    (geometry : OrbitG8Geometry rho g) {q : ℕ}
    (hq : q ∈ globalPrimeIndexSet g.convolutionSquare) :
    q ∈ orbitVisiblePrimeRange geometry := by
  exact visiblePrimeSet_subset_range_of_orbitG8Geometry geometry hq

theorem actualOwner_mem_primePowerClosure
    {rho : sourceNontrivialZeroSet} {g : CompactLogTest}
    (geometry : OrbitG8Geometry rho g) {q : ℕ}
    (hq : q ∈ globalPrimeIndexSet g.convolutionSquare) :
    q ∈ routeAPrimePowerClosure geometry := by
  have hprime : IsPrimePow q :=
    (mem_globalPrimeIndexSet_iff g.convolutionSquare q).mp hq |>.1
  obtain ⟨p, k, hp, hk, hpow⟩ := (isPrimePow_nat_iff q).mp hprime
  have hpq : p ≤ q := by
    rw [← hpow]
    exact Nat.le_pow hk
  have hp_exp : (p : ℝ) <
      Real.exp (2 * ((geometry.orbitIndex + 2 : ℕ) : ℝ)) := by
    calc
      (p : ℝ) ≤ (q : ℝ) := by exact_mod_cast hpq
      _ < Real.exp (2 * ((geometry.orbitIndex + 2 : ℕ) : ℝ)) :=
        geometry.visible_prime_cutoff q hq
  have hp_ceil : (p : ℝ) <
      (Nat.ceil (Real.exp (2 * ((geometry.orbitIndex + 2 : ℕ) : ℝ))) : ℝ) :=
    hp_exp.trans_le (Nat.le_ceil _)
  have hp_nat : p <
      Nat.ceil (Real.exp (2 * ((geometry.orbitIndex + 2 : ℕ) : ℝ))) := by
    exact_mod_cast hp_ceil
  have hp_range : p ∈ orbitVisiblePrimeRange geometry := by
    simp only [orbitVisiblePrimeRange, Finset.mem_range]
    omega
  refine ⟨p, Finset.mem_filter.mpr ⟨hp_range, hp⟩, k - 1, ?_⟩
  rw [Nat.sub_add_cancel hk]
  exact hpow

theorem actualOwner_mem_closureWithinCutoff
    {rho : sourceNontrivialZeroSet} {g : CompactLogTest}
    (geometry : OrbitG8Geometry rho g) {q : ℕ}
    (hq : q ∈ globalPrimeIndexSet g.convolutionSquare) :
    q ∈ routeAPrimePowerClosureWithinCutoff geometry := by
  classical
  unfold routeAPrimePowerClosureWithinCutoff
  apply Finset.mem_filter.mpr
  exact ⟨actualOwner_mem_cutoff geometry hq,
    actualOwner_mem_primePowerClosure geometry hq⟩

theorem actualOwner_not_mem_missingWithinCutoff
    {rho : sourceNontrivialZeroSet} {g : CompactLogTest}
    (geometry : OrbitG8Geometry rho g) {q : ℕ}
    (hq : q ∈ globalPrimeIndexSet g.convolutionSquare) :
    q ∉ routeAOwnerMissingWithinCutoff geometry := by
  classical
  unfold routeAOwnerMissingWithinCutoff at *
  intro hmissing
  exact (Finset.mem_filter.mp hmissing).2 hq

theorem closureWithinCutoff_mem_actual_or_missing
    {rho : sourceNontrivialZeroSet} {g : CompactLogTest}
    (geometry : OrbitG8Geometry rho g) {q : ℕ}
    (hq : q ∈ routeAPrimePowerClosureWithinCutoff geometry) :
    q ∈ globalPrimeIndexSet g.convolutionSquare ∨
      q ∈ routeAOwnerMissingWithinCutoff geometry := by
  classical
  by_cases hactual : q ∈ globalPrimeIndexSet g.convolutionSquare
  · exact Or.inl hactual
  · unfold routeAOwnerMissingWithinCutoff
    exact Or.inr (Finset.mem_filter.mpr ⟨hq, hactual⟩)

theorem primePowerClosure_partition
    {rho : sourceNontrivialZeroSet} {g : CompactLogTest}
    (geometry : OrbitG8Geometry rho g) {q : ℕ}
    (hq : q ∈ routeAPrimePowerClosure geometry) :
    q ∈ globalPrimeIndexSet g.convolutionSquare ∨
      q ∈ routeAOwnerMissingWithinCutoff geometry ∨
        q ∈ routeAOwnerPrimePowerTail geometry := by
  classical
  by_cases hcutoff : q ∈ orbitVisiblePrimeRange geometry
  · have hwithin : q ∈ routeAPrimePowerClosureWithinCutoff geometry :=
      by
        unfold routeAPrimePowerClosureWithinCutoff
        exact Finset.mem_filter.mpr ⟨hcutoff, hq⟩
    rcases closureWithinCutoff_mem_actual_or_missing geometry hwithin with
      hactual | hmissing
    · exact Or.inl hactual
    · exact Or.inr (Or.inl hmissing)
  · exact Or.inr (Or.inr ⟨hq, hcutoff⟩)

end
end C1RouteAOwnerPrimePowerPartition3129
end Source
end ConnesWeilRH
