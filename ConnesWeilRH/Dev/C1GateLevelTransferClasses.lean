-- Generated exact-rational data lines carry ~10^3-digit numerals and cannot
-- fit 100 columns (house convention for machine-generated data modules).
set_option linter.style.longLine false

/-- Restricted-sum pull-out: the kernel's `sumUnivSplit` read as
`(univ \ {j}).sum g = univ.sum g - g j`. -/
private theorem sdiff_sum_eq {k : ℕ} (g : Fin k → ℝ) (j : Fin k) :
    (Finset.univ \ {j}).sum g = Finset.univ.sum g - g j := by
  have h := sumUnivSplit (k := k) (g := g) j
  linarith

/-- **The s2 RATIO headline** (record 1118 section 2): the gate functional of
the window's convolution square is bounded by `U` times the true Gram form.
`hrep` is the matrix representation (ICgate of the square = the `c`-form of
the true bilinear matrix; bilinearity via the record-1117 linearity layer,
named-hypothesis slot) and `hcert` is the (a)+(b) composition slot: the
box-robust transfer instantiated at the true data. -/
theorem ratio_headline {n : ℕ} {U : ℝ} {G M : Matrix (Fin n) (Fin n) ℝ}
    {w : CompactLogTest} {c : Fin n → ℝ}
    (hrep : ICgate w.convolutionSquare = c ⬝ᵥ (M *ᵥ c))
    (hcert : c ⬝ᵥ (M *ᵥ c) ≤ U * c ⬝ᵥ (G *ᵥ c)) :
    ICgate w.convolutionSquare ≤ U * c ⬝ᵥ (G *ᵥ c) := by
  rw [hrep]
  exact hcert

/-- **The s2 ABSOLUTE headline**: adds the L2-normalization `hnorm` (a
law-34-side fact) to pin the bound at the named rational `U = -mu`. -/
theorem absolute_headline {n : ℕ} {U : ℝ} {G M : Matrix (Fin n) (Fin n) ℝ}
    {w : CompactLogTest} {c : Fin n → ℝ}
    (hrep : ICgate w.convolutionSquare = c ⬝ᵥ (M *ᵥ c))
    (hcert : c ⬝ᵥ (M *ᵥ c) ≤ U * c ⬝ᵥ (G *ᵥ c))
    (hnorm : c ⬝ᵥ (G *ᵥ c) = 1) :
    ICgate w.convolutionSquare ≤ U := by
  rw [hrep]
  rw [hnorm] at hcert
  simpa using hcert

