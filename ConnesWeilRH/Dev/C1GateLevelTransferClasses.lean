-- min slack float: 1.8512872832557472e-08

/-- Entrywise box radii of the whitened perturbation, `radp = abs Lam *
Dred_rad * abs Lam^T` (1115_qchain.json, class (2,8)). -/
noncomputable def radp_q28 : Matrix (Fin 5) (Fin 5) ℝ :=
  !![
    ( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ);
    ( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ);
    ( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ);
    ( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ);
    ( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ)
  ]

/-- The five LDL pivots: `Lam * Dred * Lam^T = diagonal dd` exactly
(1115_qchain.json field `Ldl_d`, class (2,8)). -/
noncomputable def dd_q28 : Fin 5 → ℝ := ![( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ), ( : ℝ)]

theorem hradpos_q28 : ∀ i j, 0 ≤ radp_q28 i j := by
  intro i j
  fin_cases i <;> fin_cases j <;> simp [radp_q28] <;> norm_num

set_option maxHeartbeats 2000000000 in
-- reason: the falsifier check normalizes five ~10^4-digit rational sums per index
theorem hslack_q28 : ∀ i : Fin 5,
    radp_q28 i i + ((Finset.univ \ {i}).sum fun j => (radp_q28 i j + radp_q28 j i) / 2)
      < dd_q28 i := by
  intro i
  rw [sdiff_sum_eq (fun j => (radp_q28 i j + radp_q28 j i) / 2) i]
  fin_cases i <;> simp [radp_q28, dd_q28, Fin.sum_univ_succ] <;> norm_num

/-- **Per-class whitened T-box (2,8)**: the box-robust PSD statement on the
committed data - for EVERY perturbation `E` inside the outward box the
whitened quadratic form stays nonnegative (kernel
`qform_nonneg_whitenedBox`; a true-data consumer instantiates it from `Hbox`
alone since `E` is universally quantified). -/
theorem whitenedBox_q28 {E : Matrix (Fin 5) (Fin 5) ℝ}
    (heb : ∀ i j, |E i j| ≤ radp_q28 i j) (x : Fin 5 → ℝ) :
    0 ≤ x ⬝ᵥ ((Matrix.diagonal dd_q28 + E) *ᵥ x) :=
  qform_nonneg_whitenedBox radp_q28 hradpos_q28 hslack_q28 heb x

/-- The named positive margin `mu := -U` of the (2,8) certificate
(pre-registration section 2). -/
noncomputable def mu_q28 : ℝ := -Q28.U

theorem mu_q28_pos : 0 < mu_q28 := by
  simp only [mu_q28, Q28.U]
  norm_num

/-- **Tier-1 RATIO headline (2,8)**: consumes the committed `Q28.top`
certificate - no hypothesis beyond the representation slot. -/
theorem ratio_q28 {w : CompactLogTest} {c : Fin 8 → ℝ}
    (hrep : ICgate w.convolutionSquare = c ⬝ᵥ (Q28.M *ᵥ c))
    (hker : Q28.R.mulVec c = 0) :
    ICgate w.convolutionSquare ≤ Q28.U * c ⬝ᵥ (Q28.G *ᵥ c) :=
  ratio_headline hrep (Q28.top c hker)

/-- **Tier-1 ABSOLUTE headline (2,8)**: adds the L2-normalization slot. -/
theorem absolute_q28 {w : CompactLogTest} {c : Fin 8 → ℝ}
    (hrep : ICgate w.convolutionSquare = c ⬝ᵥ (Q28.M *ᵥ c))
    (hker : Q28.R.mulVec c = 0) (hnorm : c ⬝ᵥ (Q28.G *ᵥ c) = 1) :
    ICgate w.convolutionSquare ≤ -mu_q28 := by
  have h := ratio_q28 hrep hker
  rw [hnorm] at h
  simpa [mu_q28] using h

end

