-- the kernel check of the numeral proof exceeds the default budget
/-- The raw pencil center, stated as ONE equation so the smul-bearing
term is elaborated exactly once (instance-diamond hygiene, generic
module header).  The kernel check of the numeral-equality proof over
the 40-400-digit center exceeds the default 200000-heartbeat budget
(RED-4), hence the raised bound on this declaration only. -/
theorem hD : D = U • G - M := by
  ext i j
  fin_cases i <;> fin_cases j
  all_goals (simp [U, G, M, D, Matrix.sub_apply]; norm_num)

/-- The sym-pencilling identity (additive form): `Dc` is the exact
symmetrization of the raw center `D`. -/
theorem hDc : Dc + Dc = D + D.transpose := by
  ext i j
  fin_cases i <;> fin_cases j
  all_goals (simp [D, Dc, Matrix.transpose_apply] <;> norm_num)

/-- Kernel closure, staged: `K * V` and `W * R` as concrete matrices,
their sum, and the combined identity feeding the generic theorem. -/
theorem hKV : K * V = KVc := by
  ext i j
  fin_cases i <;> fin_cases j
  all_goals simp [K, V, KVc, Matrix.mul_apply, Fin.sum_univ_succ]

theorem hWR : W * R = WRc := by
  ext i j
  fin_cases i <;> fin_cases j
  all_goals (simp [W, R, WRc, Matrix.mul_apply, Fin.sum_univ_succ] <;> norm_num)

theorem hcl : KVc + WRc = 1 := by
  ext i j
  fin_cases i <;> fin_cases j
  all_goals (simp [KVc, WRc, Matrix.add_apply] <;> norm_num)

theorem hclosure : K * V + W * R = 1 := by
  rw [hKV, hWR]
  exact hcl

/-- Reduced-pencil factorization, staged: `Dc * K`, `Kᵀ * DKc`, the two
LDL^T halves, and their combination. -/
theorem hDK : Dc * K = DKc := by
  ext i j
  fin_cases i <;> fin_cases j
  all_goals (simp [Dc, K, DKc, Matrix.mul_apply, Fin.sum_univ_succ]; norm_num)

theorem hKDK : K.transpose * DKc = Dredc := by
  ext i j
  fin_cases i <;> fin_cases j
  all_goals (simp [K, DKc, Dredc, Matrix.transpose_apply, Matrix.mul_apply, Fin.sum_univ_succ]; norm_num)

theorem hLd : L * diagonal d = Ld := by
  ext i j
  fin_cases i <;> fin_cases j
  all_goals (simp [L, d, Ld, Matrix.diagonal_apply, Matrix.mul_apply] <;> norm_num)

theorem hLdLt : Ld * L.transpose = Dredc := by
  ext i j
  fin_cases i <;> fin_cases j
  all_goals (simp [L, Ld, Dredc, Matrix.transpose_apply, Matrix.mul_apply, Fin.sum_univ_succ] <;> norm_num)

theorem hPencil :
    K.transpose * Dc * K = L * diagonal d * L.transpose := by
  rw [Matrix.mul_assoc, hDK, hKDK, ← hLdLt, ← hLd]

/-- All five LDL pivots are positive rationals. -/
theorem hd : ∀ i : Fin 5, 0 ≤ d i := by
  intro i
  fin_cases i <;> simp [d] <;> norm_num

/-- **Instance headline (3,8)**: the exact rational data carries the
certified top bound. -/
theorem top : E0SlemmaBridge.isTopBound U G M R :=
  isTopBound_of_closure_sos U G M R Dc D K V W L d hD hclosure hDc hPencil hd

