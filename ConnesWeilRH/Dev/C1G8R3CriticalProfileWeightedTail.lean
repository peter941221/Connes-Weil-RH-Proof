import ConnesWeilRH.Dev.C1G8R3CriticalMellinSecondDerivative
import ConnesWeilRH.Dev.C1G8R3WeightedExponentialTail

/-!
# Weighted critical Mellin profile tails

The positive logarithmic tail of the actual critical Mellin profile is now
controlled after multiplication by the quadratic weight generated by the
scattering-phase second derivative.
-/

namespace ConnesWeilRH
namespace Dev

open Set MeasureTheory Real
open Source
open Source.CC20Concrete

theorem integrableOn_sq_mul_ccm24CriticalMellinLogProfile_Ioi
    (f : SchwartzMap ℝ ℂ) :
    IntegrableOn
      (fun t : ℝ => (t ^ 2 : ℂ) * ccm24CriticalMellinLogProfile f t)
      (Ioi 0) volume := by
  have hmeas : AEStronglyMeasurable
      (fun t : ℝ => (t ^ 2 : ℂ) * ccm24CriticalMellinLogProfile f t)
      volume := by
    simpa only [Function.comp_def, Pi.mul_apply, id_eq, Complex.ofReal_pow] using
      (Complex.continuous_ofReal.comp (continuous_id.pow 2) |>.mul
        (continuous_ccm24CriticalMellinLogProfile f)).aestronglyMeasurable
        (μ := volume)
  let C0 : ℝ := SchwartzMap.seminorm ℂ 0 0 f
  have hmajor : IntegrableOn
      (fun t : ℝ => t ^ 2 * (C0 * Real.exp ((-1 / 2 : ℝ) * t)))
      (Ioi 0) volume := by
    have hbase := (integrableOn_sq_mul_exp_neg_mul (a := (1 / 2 : ℝ))
      (by norm_num)).const_mul C0
    refine IntegrableOn.congr_fun hbase ?_ ?_
    · intro t ht
      ring_nf
    · exact measurableSet_Ioi
  apply hmajor.mono' hmeas.restrict
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (mem_Ioi.mp ht),
    ccm24CriticalMellinLogProfile, norm_smul, Real.norm_eq_abs,
    abs_of_pos (Real.exp_pos _)]
  calc
    t ^ 2 * (Real.exp (-t / 2) * ‖f (Real.exp (-t))‖) ≤
        t ^ 2 * (Real.exp (-t / 2) * C0) := by
      gcongr
      exact SchwartzMap.norm_le_seminorm ℂ f (Real.exp (-t))
    _ = t ^ 2 * (C0 * Real.exp ((-1 / 2 : ℝ) * t)) := by
      congr 1
      ring_nf

end Dev
end ConnesWeilRH
