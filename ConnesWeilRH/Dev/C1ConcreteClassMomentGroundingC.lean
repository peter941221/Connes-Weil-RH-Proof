-- RED-7 prefix-sum machinery: one tiny declaration per step;
-- no shifted indices, no mega-tactic.  RED-9: the cached
-- coefficient enters through the symbolic Rat bridge, then the
-- literal integer table is inlined ONCE via zGround_eq_35.

def sumendpointApref : ℕ → ℚ
  | 0 => 0
  | j + 1 =>
      sumendpointApref j + listCoeffQ (powerCoefficientListQ 35) j * endpointAQ j

theorem sumendpointApref_eq (j : ℕ) :
    (∑ k ∈ Finset.range j, listCoeffQ (powerCoefficientListQ 35) k * endpointAQ k) = sumendpointApref j := by
  induction j with
  | zero => simp [sumendpointApref]
  | succ n ih =>
      rw [Finset.sum_range_succ, ih]
      rfl

