      sumendpointApref j + listCoeffQ (powerCoefficientListQ 35) j * endpointAQ j

theorem sumendpointApref_eq (j : ℕ) :
    (∑ k ∈ Finset.range j, listCoeffQ (powerCoefficientListQ 35) k * endpointAQ k) = sumendpointApref j := by
  induction j with
  | zero => simp [sumendpointApref]
  | succ n ih =>
      rw [Finset.sum_range_succ, ih]
      rfl

