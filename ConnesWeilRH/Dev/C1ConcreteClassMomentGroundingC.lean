-- RED-9 bridge: the frozen Rat definition equals the integer lift
-- divided by Q^m.  Fully symbolic (no bignum content).

def bigQ : ℕ := 35 ^ 19 * Nat.factorial 19

theorem bigQ_pos : 0 < bigQ :=
  Nat.mul_pos (by positivity) (Nat.factorial_pos 19)

theorem taylorCoefficientQ_mul_bigQ_eq_zCoeff (i : ℕ) (hi : i < 20) :
    taylorCoefficientQ i * (bigQ : ℚ) = (zCoeff i : ℚ) := by
  have hdvd : i.factorial ∣ Nat.factorial 19 :=
    Nat.factorial_dvd_factorial (by omega)
  have hcastdiv : ((Nat.factorial 19 / i.factorial : ℕ) : ℚ)
      = (Nat.factorial 19 : ℚ) / (i.factorial : ℚ) :=
    Nat.cast_div hdvd (by positivity)
  have hpow : (35 : ℚ) ^ i * (35 : ℚ) ^ (19 - i) = (35 : ℚ) ^ 19 := by
    rw [← pow_add]
    congr 1
    omega
  have hQ : (bigQ : ℚ) = (35 : ℚ) ^ 19 * (Nat.factorial 19 : ℚ) := by
    unfold bigQ
    norm_num [Nat.factorial]
  rw [taylorCoefficientQ, if_pos hi]
  unfold bigQ
  simp only [zCoeff]
  rw [show (-(2 / 35 : ℚ)) = (-2 : ℚ) / 35 by norm_num, div_pow]
  simp only [Int.cast_mul, Int.cast_pow, Int.cast_neg, Int.cast_natCast]
  rw [hcastdiv]
  field_simp [Nat.cast_pos.mpr i.factorial_pos]
  norm_num only [Nat.cast_mul, Nat.cast_pow]
  calc
    (-2 : ℚ) ^ i * 26447672832002022437587219218750000000000000000 =
        (-2 : ℚ) ^ i * ((35 : ℚ) ^ 19 * (Nat.factorial 19 : ℚ)) := by norm_num
    _ = (-2 : ℚ) ^ i * ((35 : ℚ) ^ i * 35 ^ (19 - i)) *
        (Nat.factorial 19 : ℚ) := by rw [hpow]; ring
    _ = _ := by ring

theorem getD_range_map_lt {α : Type*} [Inhabited α] (f : ℕ → α) (k : ℕ)
    (hk : k < 666) (z : α) :
    List.getD ((List.range 666).map f) k z = f k := by
  rw [List.getD_eq_getElem _ _]
  · rw [List.getElem_map]
    simp
  · simp [hk]

theorem listCoeff_eq_zDiv (m k : ℕ) (hk : k < 666) :
    listCoeffQ (powerCoefficientListQ m) k
      = ((List.getD (zLayerList m) k 0 : ℤ) : ℚ) / (bigQ : ℚ) ^ m := by
  induction m generalizing k with
  | zero =>
      rw [powerCoefficientListQ, zLayerList, zeroPowerCoefficientListQ]
      rw [listCoeff_range_map _ k hk, getD_range_map_lt _ k hk]
      by_cases h0 : k = 0
      · rw [if_pos h0, if_pos h0]
        norm_num
      · rw [if_neg h0, if_neg h0]
        norm_num
  | succ m ih =>
      change powerCoefficientQ (m + 1) k = _
      rw [powerCoefficientQ_succ m k hk, zLayerList,
        getD_range_map_lt _ k hk]
      push_cast
      calc
        (∑ i ∈ Finset.range 20, if i ≤ k then powerCoefficientQ m (k - i) * taylorCoefficientQ i else 0) =
            ∑ i ∈ Finset.range 20, (if i ≤ k then ((zLayerList m).getD (k - i) 0 : ℚ) * (zCoeff i : ℚ) else 0) / (bigQ : ℚ) ^ (m + 1) := by
          apply Finset.sum_congr rfl
          intro i hi
          by_cases hik : i ≤ k
          · have hi20 : i < 20 := Finset.mem_range.mp hi
            rw [if_pos hik, if_pos hik, powerCoefficientQ,
              ih (k - i) (by omega)]
            have hQ0 : (bigQ : ℚ) ≠ 0 :=
              Nat.cast_ne_zero.mpr (Nat.ne_of_gt bigQ_pos)
            have htc : taylorCoefficientQ i = (zCoeff i : ℚ) / (bigQ : ℚ) := by
              apply (eq_div_iff hQ0).2
              simpa [mul_comm] using
                (taylorCoefficientQ_mul_bigQ_eq_zCoeff i (by omega))
            rw [htc]
            field_simp [pow_succ, hQ0]
            rw [pow_succ]
            ring
          · simp only [if_neg hik, zero_mul, zero_div]
        _ = _ := by rw [Finset.sum_div]

-- per-index value theorems: `k + 2` equation lemmas do not match
