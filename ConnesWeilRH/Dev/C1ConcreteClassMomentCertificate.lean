private theorem groundLayer_eq_35 :
    powerCoefficientListQ 35 = groundLayer_35 := by
  show ((List.range 666).map fun k => ∑ i ∈ Finset.range 20, if i ≤ k then listCoeffQ (powerCoefficientListQ 34) (k - i) * taylorCoefficientQ i else 0) = groundLayer_35
  rw [groundLayer_eq_34]
  simp only [range_666_lit, groundLayer_34, groundLayer_35]
  norm_num (config := { maxSteps := 20000000 })
    [listCoeffQ, taylorCoefficientQ, Finset.sum_range_succ,
    Finset.sum_empty, List.getD_cons_zero, List.getD_cons_succ,
    List.map_cons, List.map_nil]

-- per-index value theorems: `k + 2` equation lemmas do not match
-- closed Nat literals under simp, so each index is grounded
-- through the step theorem with an explicit `n + 1 + 1` bridge.

private theorem endpointAQ_step (n : ℕ) :
    endpointAQ (n + 1 + 1) = rationalRadiusQ /
        (((n : ℚ) + 1) * (1 - rationalRadiusQ ^ 2) ^ (n + 1)) +
      ((2 * (n : ℚ) + 1) / (2 * ((n : ℚ) + 1))) *
        endpointAQ (n + 1) := by
  rw [endpointAQ]

private theorem endpointBQ_step (n : ℕ) :
    endpointBQ (n + 1 + 1) = ((2 * (n : ℚ) + 1) / (2 * ((n : ℚ) + 1))) *
        endpointBQ (n + 1) := by
  rw [endpointBQ]

private theorem momentAQ_step (n : ℕ) :
    momentAQ (n + 1 + 1) = endpointAQ (n + 1) - endpointAQ n := by
  rw [momentAQ]

private theorem momentBQ_step (n : ℕ) :
    momentBQ (n + 1 + 1) = endpointBQ (n + 1) - endpointBQ n := by
  rw [momentBQ]

