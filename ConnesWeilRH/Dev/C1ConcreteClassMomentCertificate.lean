private theorem rationalPowerIntervalValue_linear (k : ℕ) :
    rationalPowerIntervalValue k =
      (endpointAQ k : ℝ) + (endpointBQ k : ℝ) * Real.log (197 / 3) := by
  induction k with
  | zero =>
