import ConnesWeilRH.Dev.C1G8P1MetricChannels
import ConnesWeilRH.Dev.C1G8P1MetricProjectionFactorization

/-!
# G8 P1 metric projection-defect ledger

The existing same-owner endpoint identities have a common internal correction.
Cancelling that correction exposes the exact difference between the raw cutoff
trace product and the literal metric cutoff: the three channels generated by
the source-projection complement. No sign or vanishing of these channels is
asserted.
-/

namespace ConnesWeilRH
namespace Source
namespace C1G8P1MetricProjectionDefectLedger

open CC20Concrete
open CC20Concrete.PositiveTrace
open CCM25Concrete
open CCM25Concrete.CCM24FiniteSProjectionTrace
open CCM25Concrete.CCM24FiniteSGramResponse
open C1G8AdjointShearGram
open C1G8P1MetricBoundary
open C1G8P1MetricChannels
open C1G8P1MetricProjectionFactorization
open scoped InnerProduct InnerProductSpace

noncomputable section

noncomputable local instance sourceSoninCarrierCompleteSpace
    (lambda : CCM24SoninScale) : CompleteSpace (sourceSoninCarrier lambda) :=
    (ccm24ArchimedeanSoninClosedSubspace lambda).isClosed.completeSpace_coe

theorem g8SourceCutoffPairData_traceProduct_eq_metric_add_projectionDefect
    {ι ρ : Type*}
    (owner : SelectedWeilSquare.SelectedWeilSquareOwner)
    (lambda : CCM24SoninScale) (family : FinitePrimePowerFamily)
    (globalBasis : HilbertBasis ι ℂ finiteSCarrier)
    (sourceBasis : HilbertBasis ρ ℂ (sourceSoninCarrier lambda)) (n : Nat) :
    (g8SourceCutoffPairData owner lambda family globalBasis sourceBasis n).traceProduct =
      g8PhysicalMetricCutoffOperator owner lambda family globalBasis sourceBasis n +
        let C := (sourceInclusion lambda)† ∘L
          (g8SourceCutoffPairData owner lambda family globalBasis sourceBasis n).left
        let J := sourceInclusion lambda
        let D := g8SourceCutoffComplementLeg owner lambda family globalBasis sourceBasis n
        let G := g8AdjointShearGram owner lambda family
        C† ∘L J† ∘L G ∘L D +
          D† ∘L G ∘L J ∘L C +
          D† ∘L G ∘L D := by
  have hmetric :=
    g8PhysicalEndpointSourceCutoffPairData_traceProduct_eq_metric_add_internal
      owner lambda family globalBasis sourceBasis n
  have hfull :=
    g8PhysicalEndpointSourceCutoffPairData_traceProduct_eq_g8_add_internal_sub_complement
      owner lambda family globalBasis sourceBasis n
  rw [g8PhysicalMetricCutoffOperator]
  dsimp only at hmetric hfull ⊢
  have h := hmetric.symm.trans hfull
  have cancel
      (M I S X : sourceSoninCarrier lambda →L[ℂ] sourceSoninCarrier lambda)
      (hcancel : M + I = S + I - X) : S = M + X := by
    calc
      S = (S + I - X) + X - I := by
        apply ContinuousLinearMap.ext
        intro u
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply]
        module
      _ = (M + I) + X - I := by rw [← hcancel]
      _ = M + X := by
        apply ContinuousLinearMap.ext
        intro u
        simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply]
        module
  apply cancel _ _ _ _
  simpa only [sub_eq_add_neg, add_assoc] using h

end
end C1G8P1MetricProjectionDefectLedger
end Source
end ConnesWeilRH
