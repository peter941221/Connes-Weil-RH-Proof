-- the integer lift of the Taylor coefficients over
-- Q = 35^19 * 19!:  taylorCoefficientQ i = zCoeff i / Q.
def zCoeff (i : ℕ) : ℤ :=
  (-2 : ℤ) ^ i * (35 : ℤ) ^ (19 - i) *
    ((Nat.factorial 19 / i.factorial : ℕ) : ℤ)

-- the same convolution as powerCoefficientListQ, in integers:
-- layer m (k) * Q^m.  Only its PER-LAYER literal values are
-- ever forced (one step at a time via the groundings below).
def zLayerList : ℕ → List ℤ
  | 0 => (List.range 666).map fun k => if k = 0 then 1 else 0
  | m + 1 =>
      (List.range 666).map fun k => ∑ i ∈ Finset.range 20,
        if i ≤ k then List.getD (zLayerList m) (k - i) 0 *
          zCoeff i else 0

