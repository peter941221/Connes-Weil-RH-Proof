import ConnesWeilRH.Source.CCM25Concrete.CCM24FiniteSGatePhysicalNormalizedDoubleBoundaryReduction
import Mathlib.Tactic.NoncommRing

/-!
# Metric-detector corner form of the finite-S Gate target

The normalized double-boundary target contains the product
`[R, H_S] [W, R]`, where `R` is the source Sonin projection, `H_S` is the
finite-Euler ambient Gram operator, and `W` is the detector.  This module
keeps that product whole but records its exact two-corner block form.  The
source target reads only the `R` corner; the complementary corner is killed by
the source inclusion.

This is an operator identity.  It does not estimate either corner, prove a
support-polynomial Gate 3U bound, or assert a sign.
-/

namespace ConnesWeilRH
namespace Source
namespace CCM25Concrete
namespace CCM24FiniteSGatePhysicalMetricDetectorCorner

open scoped InnerProduct InnerProductSpace

open CC20Concrete
open CCM24FiniteSActualBandQuadraticCycle
open CCM24FiniteSGramOrderingBridge
open CCM24FiniteSGramResponse
open CCM24FiniteSGatePhysicalNormalizedDoubleBoundaryReduction
open CCM24FiniteSGatePhysicalObliqueShearKernelReduction
open CCM24FiniteSProjectionTrace

noncomputable local instance sourceSoninCarrierCompleteSpace
    (lambda : CCM24SoninScale) : CompleteSpace (sourceSoninCarrier lambda) :=
  (ccm24ArchimedeanSoninClosedSubspace lambda).isClosed.completeSpace_coe

private theorem idempotent_double_boundary_eq_two_corners
    {A : Type*} [Ring A] (R H W : A) (hR : R * R = R) :
    (R * H - H * R) * (W * R - R * W) =
      R * H * (1 - R) * W * R + (1 - R) * H * R * W * (1 - R) := by
  calc
    (R * H - H * R) * (W * R - R * W) =
        R * H * W * R - R * H * R * W - H * R * W * R + H * (R * R) * W := by
      noncomm_ring
    _ = R * H * W * R - R * H * R * W - H * R * W * R + H * R * W := by
      rw [hR]
    _ = R * H * (1 - R) * W * R + (1 - R) * H * R * W * (1 - R) := by
      noncomm_ring

/-- The finite-Euler ambient Gram operator commutes with the fixed detector.
Both are generated by the same global logarithmic translations. -/
theorem finiteEulerAmbientGram_comp_detector
    (owner : SelectedWeilSquare.SelectedWeilSquareOwner)
    (family : FinitePrimePowerFamily) :
    finiteEulerAmbientGram family ∘L detectorOperator owner =
      detectorOperator owner ∘L finiteEulerAmbientGram family := by
  apply ContinuousLinearMap.ext
  intro u
  let transport :=
    (ccm24FiniteEulerTransportEquiv family.visiblePrimes).toContinuousLinearMap
  have hForward := congrArg
    (fun operator : finiteSCarrier →L[ℂ] finiteSCarrier => operator u)
    (detectorOperator_comp_finiteEulerTransport owner family.visiblePrimes)
  have hAdjoint := congrArg
    (fun operator : finiteSCarrier →L[ℂ] finiteSCarrier => operator (transport u))
    (finiteEulerTransportAdjoint_comp_detector owner family.visiblePrimes)
  simp only [ContinuousLinearMap.comp_apply] at hForward hAdjoint
  change transport.adjoint (transport (detectorOperator owner u)) =
    detectorOperator owner (transport.adjoint (transport u))
  rw [← hForward]
  exact hAdjoint

/-- The full metric/detector double boundary is block diagonal for the source
projection.  The two displayed terms are its source and complement corners. -/
theorem finiteEulerMetricDetectorDoubleBoundary_eq_twoCorners
    (owner : SelectedWeilSquare.SelectedWeilSquareOwner)
    (lambda : CCM24SoninScale) (family : FinitePrimePowerFamily) :
    finiteEulerMetricBoundaryCommutator lambda family ∘L
        sourceBoundaryCommutator owner lambda =
      sourceSoninProjection lambda ∘L finiteEulerAmbientGram family ∘L
          sourceSoninComplementProjection lambda ∘L detectorOperator owner ∘L
            sourceSoninProjection lambda +
        sourceSoninComplementProjection lambda ∘L finiteEulerAmbientGram family ∘L
          sourceSoninProjection lambda ∘L detectorOperator owner ∘L
            sourceSoninComplementProjection lambda := by
  have hR : sourceSoninProjection lambda * sourceSoninProjection lambda =
      sourceSoninProjection lambda := by
    simpa only [ContinuousLinearMap.mul_def] using
      (sourceSoninProjection_isStarProjection lambda).isIdempotentElem
  simpa only [finiteEulerMetricBoundaryCommutator, sourceBoundaryCommutator,
    sourceSoninComplementProjection, ContinuousLinearMap.mul_def] using
    idempotent_double_boundary_eq_two_corners (sourceSoninProjection lambda)
      (finiteEulerAmbientGram family) (detectorOperator owner) hR

/-- The source inclusion is annihilated by the source-Sonin complement. -/
theorem sourceSoninComplementProjection_comp_sourceInclusion_eq_zero
    (lambda : CCM24SoninScale) :
    sourceSoninComplementProjection lambda ∘L sourceInclusion lambda = 0 := by
  apply ContinuousLinearMap.ext
  intro u
  have hSource := congrArg
    (fun operator : sourceSoninCarrier lambda →L[ℂ] finiteSCarrier => operator u)
    (sourceSoninProjection_comp_sourceInclusion_eq_self lambda)
  simp only [ContinuousLinearMap.comp_apply] at hSource
  simp only [sourceSoninComplementProjection, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply,
    ContinuousLinearMap.zero_apply]
  rw [hSource, sub_self]

/-- Compressing the two-corner double boundary back to the source carrier keeps
only the complete metric-to-detector crossing.  No trace cycle is used. -/
theorem sourceCompression_metricDetectorDoubleBoundary_eq_singleCorner
    (owner : SelectedWeilSquare.SelectedWeilSquareOwner)
    (lambda : CCM24SoninScale) (family : FinitePrimePowerFamily) :
    (sourceInclusion lambda)† ∘L
        finiteEulerMetricBoundaryCommutator lambda family ∘L
          sourceBoundaryCommutator owner lambda ∘L sourceInclusion lambda =
      (sourceInclusion lambda)† ∘L finiteEulerAmbientGram family ∘L
        sourceSoninComplementProjection lambda ∘L detectorOperator owner ∘L
          sourceInclusion lambda := by
  apply ContinuousLinearMap.ext
  intro u
  have hBlocks := congrArg
    (fun operator : finiteSCarrier →L[ℂ] finiteSCarrier =>
      ((sourceInclusion lambda)†) (operator (sourceInclusion lambda u)))
    (finiteEulerMetricDetectorDoubleBoundary_eq_twoCorners owner lambda family)
  have hLeft (v : finiteSCarrier) :
      ((sourceInclusion lambda)†) (sourceSoninProjection lambda v) =
        ((sourceInclusion lambda)†) v := congrArg
    (fun operator : finiteSCarrier →L[ℂ] sourceSoninCarrier lambda => operator v)
    (sourceInclusionAdjoint_comp_sourceProjection lambda)
  have hRight := congrArg
    (fun operator : sourceSoninCarrier lambda →L[ℂ] finiteSCarrier => operator u)
    (sourceSoninProjection_comp_sourceInclusion_eq_self lambda)
  have hComplement := congrArg
    (fun operator : sourceSoninCarrier lambda →L[ℂ] finiteSCarrier => operator u)
    (sourceSoninComplementProjection_comp_sourceInclusion_eq_zero lambda)
  simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.add_apply,
    ContinuousLinearMap.zero_apply, map_add] at hBlocks hRight hComplement ⊢
  rw [hBlocks, hRight, hComplement]
  simp only [map_zero, add_zero]
  rw [hLeft]

/-- The active finite-S target is the source corner of the complete
metric/detector double boundary.  Equivalently, it is one unsplit physical
metric crossing against the compact-root detector boundary. -/
theorem finiteEulerTargetCommutatorResponse_eq_singleMetricDetectorCorner
    (owner : SelectedWeilSquare.SelectedWeilSquareOwner)
    (lambda : CCM24SoninScale) (family : FinitePrimePowerFamily) :
    finiteEulerTargetCommutatorResponse owner lambda family =
      finiteEulerGramInv lambda family ∘L (sourceInclusion lambda)† ∘L
        finiteEulerAmbientGram family ∘L
          sourceSoninComplementProjection lambda ∘L detectorOperator owner ∘L
            sourceInclusion lambda := by
  rw [finiteEulerTargetCommutatorResponse_eq_doubleBoundary]
  apply ContinuousLinearMap.ext
  intro u
  have hCompression := congrArg
    (fun operator : sourceSoninCarrier lambda →L[ℂ] sourceSoninCarrier lambda =>
      finiteEulerGramInv lambda family (operator u))
    (sourceCompression_metricDetectorDoubleBoundary_eq_singleCorner owner lambda family)
  simpa only [ContinuousLinearMap.comp_apply] using hCompression

end CCM24FiniteSGatePhysicalMetricDetectorCorner
