noncomputable local instance sourceSoninCarrierCompleteSpace
    (lambda : CCM24SoninScale) : CompleteSpace
      (sourceSoninCarrier lambda) :=
  (ccm24ArchimedeanSoninClosedSubspace lambda).isClosed.completeSpace_coe

/-! ## Scalar-free response target -/

/-- A response-facing Bone 1 factor satisfies the scalar-free raw
intertwining factorization.  This removes the harmless positive scalar but
does not construct the factor. -/
theorem
    scalarFreeFactorization
    {owner : SelectedWeilSquare.SelectedWeilSquareOwner}
    {lambda : CCM24SoninScale} {p : CCM24VisiblePrime}
    {S : List CCM24VisiblePrime} {bound : ℝ}
    (data : SuffixRawOldCarrierCoframeJointGapResponseReadoutData owner
      lambda p S bound) :
    (suffixEulerFrameSchurStep lambda p S).oldFrame ∘L
        suffixActualBandRawQuadraticIntertwiningDefect owner lambda p S =
      (suffixEulerFrameAmbientBoundaryOldCarrierAnalysis lambda p S)† ∘L
        data.factor := by
  have hrho : (primeSchurMarkovScalar p : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt (primeSchurMarkovScalar_pos p))
  have hresponse :=
    suffixActualBandRawPhysicalOldCarrierCoframeJointGapResponse_comp_transition_eq_neg_scalar_gap_adjoint
      owner lambda p S
  have hrow :
      (coframeBoundaryMomentGap owner lambda p S)† =
        suffixActualBandRawQuadraticIntertwiningDefect owner lambda p S := by
    rw [coframeBoundaryMomentGap_eq_rawPhysicalFourTermRow,
      suffixActualBandRawPhysicalFourTermRow_adjoint_eq_rawIntertwiningDefect]
  have hscaled :
      -((primeSchurMarkovScalar p : ℂ) •
          ((suffixEulerFrameSchurStep lambda p S).oldFrame ∘L
            suffixActualBandRawQuadraticIntertwiningDefect owner lambda p S)) =
        -((primeSchurMarkovScalar p : ℂ) •
          ((suffixEulerFrameAmbientBoundaryOldCarrierAnalysis lambda p S)† ∘L
            data.factor)) := by
    apply ContinuousLinearMap.ext
    intro x
    have hresponsePoint := congrArg
      (fun operator : sourceSoninCarrier lambda →L[ℂ]
          sourceSoninCarrier lambda =>
        (suffixEulerFrameSchurStep lambda p S).oldFrame (operator x))
      hresponse
    have hdataPoint := DFunLike.congr_fun data.response_factorization x
    rw [hrow] at hresponsePoint
    simp only [ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.smul_apply, ContinuousLinearMap.neg_apply,
      map_smul, map_neg] at hresponsePoint hdataPoint ⊢
    exact hresponsePoint.symm.trans hdataPoint
  exact eq_of_neg_smul_eq_neg_smul hrho hscaled

/-! ## The common antiresonant column on the new-frame range -/

/-- Orthogonal complement of the actual new-frame range. -/
noncomputable def suffixEulerFrameNewRangeComplement
    (lambda : CCM24SoninScale) (p : CCM24VisiblePrime)
    (S : List CCM24VisiblePrime) :
    finiteSCarrier →L[ℂ] finiteSCarrier :=
  ContinuousLinearMap.id ℂ finiteSCarrier -
    (suffixEulerFrameSchurStep lambda p S).newFrame ∘L
      ContinuousLinearMap.adjoint
        (suffixEulerFrameSchurStep lambda p S).newFrame

theorem suffixEulerFrameNewRangeComplement_isStarProjection
    (lambda : CCM24SoninScale) (p : CCM24VisiblePrime)
    (S : List CCM24VisiblePrime) :
    IsStarProjection (suffixEulerFrameNewRangeComplement lambda p S) := by
  let frame := (suffixEulerFrameSchurStep lambda p S).newFrame
  let projection : finiteSCarrier →L[ℂ] finiteSCarrier :=
    frame ∘L ContinuousLinearMap.adjoint frame
  have hframe : ContinuousLinearMap.adjoint frame ∘L frame =
      ContinuousLinearMap.id ℂ (sourceSoninCarrier lambda) := by
    simpa only [frame] using
      (suffixEulerFrameSchurStep lambda p S).newFrame_isometry
  have hprojection : IsStarProjection projection := by
    refine
      { isIdempotentElem := ?_
        isSelfAdjoint := ?_ }
    · have hsq : projection ∘L projection = projection := by
        apply ContinuousLinearMap.ext
        intro x
        have hpoint := congrArg
          (fun operator : sourceSoninCarrier lambda →L[ℂ]
            sourceSoninCarrier lambda =>
            frame (operator (ContinuousLinearMap.adjoint frame x))) hframe
        simpa only [projection, ContinuousLinearMap.comp_apply,
          ContinuousLinearMap.id_apply] using hpoint
      simpa only [ContinuousLinearMap.mul_def] using hsq
    · change projection† = projection
      simp only [projection, ContinuousLinearMap.adjoint_comp,
        ContinuousLinearMap.adjoint_adjoint]
  simpa only [suffixEulerFrameNewRangeComplement, projection, frame] using
    hprojection.one_sub

theorem suffixEulerFrameNewRangeComplement_norm_le_one
    (lambda : CCM24SoninScale) (p : CCM24VisiblePrime)
    (S : List CCM24VisiblePrime) :
    ‖suffixEulerFrameNewRangeComplement lambda p S‖ ≤ (1 : ℝ) :=
  IsStarProjection.norm_le _
    (suffixEulerFrameNewRangeComplement_isStarProjection lambda p S)

/-- The uniformly bounded map which reconstructs both physical coordinates
from the ambient-loss coordinate on the new-frame range. -/
noncomputable def suffixEulerFrameNewRangeAmbientLossLift
    (lambda : CCM24SoninScale) (p : CCM24VisiblePrime)
    (S : List CCM24VisiblePrime) :
    finiteSCarrier →L[ℂ] suffixEulerFrameAmbientBoundaryCarrier :=
  suffixEulerFrameAmbientBoundaryLeftEmbedding +
    suffixEulerFrameAmbientBoundaryRightEmbedding ∘L
      (-((Real.sqrt (ccm24PrimeEulerCoefficient p) : ℂ) •
        suffixEulerFrameNewRangeComplement lambda p S))

@[simp]
theorem suffixEulerFrameNewRangeAmbientLossLift_apply
    (lambda : CCM24SoninScale) (p : CCM24VisiblePrime)
    (S : List CCM24VisiblePrime) (x : finiteSCarrier) :
    suffixEulerFrameNewRangeAmbientLossLift lambda p S x =
      suffixEulerFrameAmbientBoundaryLeftEmbedding x +
        suffixEulerFrameAmbientBoundaryRightEmbedding
          (-((Real.sqrt (ccm24PrimeEulerCoefficient p) : ℂ) •
            suffixEulerFrameNewRangeComplement lambda p S x)) := by
  rfl

theorem suffixEulerFrameNewRangeAmbientLossLift_norm_le_two
    (lambda : CCM24SoninScale) (p : CCM24VisiblePrime)
    (S : List CCM24VisiblePrime) :
    ‖suffixEulerFrameNewRangeAmbientLossLift lambda p S‖ ≤ (2 : ℝ) := by
  apply ContinuousLinearMap.opNorm_le_bound _ (by norm_num)
  intro x
  have hleft :
      ‖suffixEulerFrameAmbientBoundaryLeftEmbedding x‖ ≤ ‖x‖ := by
    calc
      ‖suffixEulerFrameAmbientBoundaryLeftEmbedding x‖ ≤
          ‖suffixEulerFrameAmbientBoundaryLeftEmbedding‖ * ‖x‖ :=
        suffixEulerFrameAmbientBoundaryLeftEmbedding.le_opNorm x
      _ ≤ 1 * ‖x‖ := by
        exact mul_le_mul_of_nonneg_right
          suffixEulerFrameAmbientBoundaryLeftEmbedding_norm_le_one
          (norm_nonneg x)
      _ = ‖x‖ := by simp
  have hcomplement :
      ‖suffixEulerFrameNewRangeComplement lambda p S x‖ ≤ ‖x‖ := by
    calc
      ‖suffixEulerFrameNewRangeComplement lambda p S x‖ ≤
          ‖suffixEulerFrameNewRangeComplement lambda p S‖ * ‖x‖ :=
        (suffixEulerFrameNewRangeComplement lambda p S).le_opNorm x
      _ ≤ 1 * ‖x‖ := by
        exact mul_le_mul_of_nonneg_right
          (suffixEulerFrameNewRangeComplement_norm_le_one lambda p S)
          (norm_nonneg x)
      _ = ‖x‖ := by simp
  have hsqrt := sqrtPrimeEulerCoefficient_norm_le_one p
  have hscaled :
      ‖-((Real.sqrt (ccm24PrimeEulerCoefficient p) : ℂ) •
          suffixEulerFrameNewRangeComplement lambda p S x)‖ ≤ ‖x‖ := by
    rw [norm_neg, norm_smul]
    calc
      ‖(Real.sqrt (ccm24PrimeEulerCoefficient p) : ℂ)‖ *
            ‖suffixEulerFrameNewRangeComplement lambda p S x‖ ≤
          1 * ‖x‖ :=
        mul_le_mul hsqrt hcomplement (norm_nonneg _) zero_le_one
      _ = ‖x‖ := by simp
  have hright :
      ‖suffixEulerFrameAmbientBoundaryRightEmbedding
          (-((Real.sqrt (ccm24PrimeEulerCoefficient p) : ℂ) •
            suffixEulerFrameNewRangeComplement lambda p S x))‖ ≤ ‖x‖ := by
    calc
      _ ≤ ‖suffixEulerFrameAmbientBoundaryRightEmbedding‖ *
          ‖-((Real.sqrt (ccm24PrimeEulerCoefficient p) : ℂ) •
            suffixEulerFrameNewRangeComplement lambda p S x)‖ :=
        suffixEulerFrameAmbientBoundaryRightEmbedding.le_opNorm _
      _ ≤ 1 * ‖x‖ :=
        mul_le_mul suffixEulerFrameAmbientBoundaryRightEmbedding_norm_le_one
          hscaled (norm_nonneg _) zero_le_one
      _ = ‖x‖ := by simp
  rw [suffixEulerFrameNewRangeAmbientLossLift_apply]
  calc
    _ ≤ ‖suffixEulerFrameAmbientBoundaryLeftEmbedding x‖ +
        ‖suffixEulerFrameAmbientBoundaryRightEmbedding
          (-((Real.sqrt (ccm24PrimeEulerCoefficient p) : ℂ) •
            suffixEulerFrameNewRangeComplement lambda p S x))‖ := norm_add_le _ _
    _ ≤ ‖x‖ + ‖x‖ := add_le_add hleft hright
    _ = 2 * ‖x‖ := by ring

/-- On the new-frame range the complete two-channel analysis is generated by
the single antiresonant ambient-loss column. -/
theorem suffixEulerFrameAmbientBoundaryOldCarrierAnalysis_comp_newFrame_eq_lift_comp_ambientLoss
    (lambda : CCM24SoninScale) (p : CCM24VisiblePrime)
    (S : List CCM24VisiblePrime) :
    suffixEulerFrameAmbientBoundaryOldCarrierAnalysis lambda p S ∘L
        (suffixEulerFrameSchurStep lambda p S).newFrame =
      suffixEulerFrameNewRangeAmbientLossLift lambda p S ∘L
        (primeEulerAmbientLossFactor p)† ∘L
          (suffixEulerFrameSchurStep lambda p S).newFrame := by
  let frame := (suffixEulerFrameSchurStep lambda p S).newFrame
  let complement := suffixEulerFrameNewRangeComplement lambda p S
  have hframe : ContinuousLinearMap.adjoint frame ∘L frame =
      ContinuousLinearMap.id ℂ (sourceSoninCarrier lambda) := by
    simpa only [frame] using
      (suffixEulerFrameSchurStep lambda p S).newFrame_isometry
  have hcomplementFrame : complement ∘L frame = 0 := by
    apply ContinuousLinearMap.ext
    intro x
    have hpoint := DFunLike.congr_fun hframe x
    simp only [ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.id_apply] at hpoint
    change frame x - frame (ContinuousLinearMap.adjoint frame (frame x)) = 0
    rw [hpoint]
    simp
  have htransport :=
    normalizedPrimeEulerFrameTransport_adjoint_sub_id_eq_neg_sqrtCoefficient_smul_primeEulerAmbientLossFactor_adjoint
      p
  apply ContinuousLinearMap.ext
  intro x
  have htransportPoint := DFunLike.congr_fun htransport (frame x)
  have hboundary :
      complement
          (ContinuousLinearMap.adjoint
            (normalizedPrimeEulerFrameTransport p) (frame x)) =
        -((Real.sqrt (ccm24PrimeEulerCoefficient p) : ℂ) •
          complement (ContinuousLinearMap.adjoint
            (primeEulerAmbientLossFactor p) (frame x))) := by
    have hzero := DFunLike.congr_fun hcomplementFrame x
    simp only [ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.zero_apply] at hzero
    simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply,
      ContinuousLinearMap.smul_apply, ContinuousLinearMap.neg_apply]
      at htransportPoint
    calc
      complement (ContinuousLinearMap.adjoint
          (normalizedPrimeEulerFrameTransport p) (frame x)) =
          complement
            ((ContinuousLinearMap.adjoint
                (normalizedPrimeEulerFrameTransport p) (frame x) - frame x) +
              frame x) := by
          congr 1
          module
      _ = complement
            (ContinuousLinearMap.adjoint
              (normalizedPrimeEulerFrameTransport p) (frame x) - frame x) := by
          rw [map_add, hzero, add_zero]
      _ = complement
            (-((Real.sqrt (ccm24PrimeEulerCoefficient p) : ℂ) •
              ContinuousLinearMap.adjoint
                (primeEulerAmbientLossFactor p) (frame x))) := by
          rw [htransportPoint]
      _ = -((Real.sqrt (ccm24PrimeEulerCoefficient p) : ℂ) •
          complement (ContinuousLinearMap.adjoint
            (primeEulerAmbientLossFactor p) (frame x))) := by
          simp only [map_neg, map_smul]
  simp only [ContinuousLinearMap.comp_apply]
  change suffixEulerFrameAmbientBoundaryOldCarrierAnalysis lambda p S
      (frame x) =
    suffixEulerFrameNewRangeAmbientLossLift lambda p S
      (ContinuousLinearMap.adjoint (primeEulerAmbientLossFactor p) (frame x))
  rw [suffixEulerFrameAmbientBoundaryOldCarrierAnalysis_apply,
    suffixEulerFrameNewRangeAmbientLossLift_apply]
  let ambient :=
    ContinuousLinearMap.adjoint (primeEulerAmbientLossFactor p) (frame x)
  let boundary := -((Real.sqrt (ccm24PrimeEulerCoefficient p) : ℂ) •
    complement ambient)
  have hcombine := suffixEulerFrameAmbientBoundary_left_add_right
    (WithLp.toLp 2 (ambient, boundary))
  simp only [WithLp.toLp_fst, WithLp.toLp_snd] at hcombine
  rw [hcombine]
  exact congrArg (WithLp.toLp 2) (Prod.ext rfl hboundary)

/-! ## Necessary antiresonant readout for Bone 1 -/

/-- Restrict a response-facing Bone 1 factor to the new-frame range and
absorb the uniformly bounded two-coordinate lift. -/
noncomputable def
    newFrameAntiresonantReadout
    {owner : SelectedWeilSquare.SelectedWeilSquareOwner}
    {lambda : CCM24SoninScale} {p : CCM24VisiblePrime}
    {S : List CCM24VisiblePrime} {bound : ℝ}
    (data : SuffixRawOldCarrierCoframeJointGapResponseReadoutData owner
      lambda p S bound) :
    finiteSCarrier →L[ℂ] sourceSoninCarrier lambda :=
  data.factor† ∘L suffixEulerFrameNewRangeAmbientLossLift lambda p S

theorem
    newFrameAntiresonantReadout_norm_le
    {owner : SelectedWeilSquare.SelectedWeilSquareOwner}
    {lambda : CCM24SoninScale} {p : CCM24VisiblePrime}
    {S : List CCM24VisiblePrime} {bound : ℝ}
    (data : SuffixRawOldCarrierCoframeJointGapResponseReadoutData owner
      lambda p S bound) :
    ‖newFrameAntiresonantReadout data‖ ≤ 2 * bound := by
  unfold newFrameAntiresonantReadout
  calc
    ‖data.factor† ∘L
        suffixEulerFrameNewRangeAmbientLossLift lambda p S‖ ≤
      ‖data.factor†‖ *
        ‖suffixEulerFrameNewRangeAmbientLossLift lambda p S‖ :=
      ContinuousLinearMap.opNorm_comp_le _ _
    _ = ‖data.factor‖ *
        ‖suffixEulerFrameNewRangeAmbientLossLift lambda p S‖ := by
      exact congrArg
        (fun r : ℝ => r *
          ‖suffixEulerFrameNewRangeAmbientLossLift lambda p S‖)
        (ContinuousLinearMap.adjoint.norm_map data.factor)
    _ ≤ bound * 2 := by
      exact mul_le_mul data.factor_norm_le
        (suffixEulerFrameNewRangeAmbientLossLift_norm_le_two lambda p S)
        (norm_nonneg _) data.bound_nonneg
    _ = 2 * bound := by ring

/-- Every Bone 1 response factor forces the reduced raw row on the new-frame
range to be boundedly divisible by the single ambient-loss column. -/
theorem
    newFrameAntiresonantReadout_factorization
    {owner : SelectedWeilSquare.SelectedWeilSquareOwner}
    {lambda : CCM24SoninScale} {p : CCM24VisiblePrime}
    {S : List CCM24VisiblePrime} {bound : ℝ}
    (data : SuffixRawOldCarrierCoframeJointGapResponseReadoutData owner
      lambda p S bound) :
    newFrameAntiresonantReadout data ∘L
          (primeEulerAmbientLossFactor p)† ∘L
            (suffixEulerFrameSchurStep lambda p S).newFrame =
      suffixActualBandRawPhysicalReducedRow owner lambda p S ∘L
        (suffixEulerFrameSchurStep lambda p S).newFrame := by
  have hscalar := scalarFreeFactorization data
  have hadjoint := congrArg ContinuousLinearMap.adjoint hscalar
  have hreadout :
      data.factor† ∘L
          suffixEulerFrameAmbientBoundaryOldCarrierAnalysis lambda p S =
        suffixActualBandRawPhysicalReducedRow owner lambda p S := by
    calc
      data.factor† ∘L
            suffixEulerFrameAmbientBoundaryOldCarrierAnalysis lambda p S =
          (suffixActualBandRawQuadraticIntertwiningDefect owner lambda p S)† ∘L
            (suffixEulerFrameSchurStep lambda p S).oldFrame† := by
        simpa only [ContinuousLinearMap.adjoint_comp,
          ContinuousLinearMap.adjoint_adjoint] using hadjoint.symm
      _ = suffixActualBandRawPhysicalFourTermRow owner lambda p S ∘L
            (suffixEulerFrameSchurStep lambda p S).oldFrame† := by
        rw [suffixActualBandRawQuadraticIntertwiningDefect_adjoint_eq_fourTermRow]
      _ = suffixActualBandRawPhysicalReducedRow owner lambda p S := by
        rfl
  calc
    newFrameAntiresonantReadout data ∘L
          (primeEulerAmbientLossFactor p)† ∘L
            (suffixEulerFrameSchurStep lambda p S).newFrame =
        data.factor† ∘L
          (suffixEulerFrameNewRangeAmbientLossLift lambda p S ∘L
            (primeEulerAmbientLossFactor p)† ∘L
              (suffixEulerFrameSchurStep lambda p S).newFrame) := by
      simp only [
        newFrameAntiresonantReadout,
        ContinuousLinearMap.comp_assoc]
    _ = data.factor† ∘L
          (suffixEulerFrameAmbientBoundaryOldCarrierAnalysis lambda p S ∘L
            (suffixEulerFrameSchurStep lambda p S).newFrame) := by
      rw [suffixEulerFrameAmbientBoundaryOldCarrierAnalysis_comp_newFrame_eq_lift_comp_ambientLoss]
    _ = (data.factor† ∘L
          suffixEulerFrameAmbientBoundaryOldCarrierAnalysis lambda p S) ∘L
            (suffixEulerFrameSchurStep lambda p S).newFrame := by
      simp only [ContinuousLinearMap.comp_assoc]
    _ = suffixActualBandRawPhysicalReducedRow owner lambda p S ∘L
          (suffixEulerFrameSchurStep lambda p S).newFrame := by
      rw [hreadout]

/-- Pointwise necessary inequality on the new-frame range.  Any actual Bone 1
factor must control the reduced row by the antiresonant ambient-loss column,
with no use of a spectral gap. -/
theorem reducedRow_newFrame_norm_le_ambientLoss_of_responseReadout
    {owner : SelectedWeilSquare.SelectedWeilSquareOwner}
    {lambda : CCM24SoninScale} {p : CCM24VisiblePrime}
    {S : List CCM24VisiblePrime} {bound : ℝ}
    (data : SuffixRawOldCarrierCoframeJointGapResponseReadoutData owner
      lambda p S bound) (x : sourceSoninCarrier lambda) :
    ‖suffixActualBandRawPhysicalReducedRow owner lambda p S
        ((suffixEulerFrameSchurStep lambda p S).newFrame x)‖ ≤
      (2 * bound) *
        ‖ContinuousLinearMap.adjoint (primeEulerAmbientLossFactor p)
          ((suffixEulerFrameSchurStep lambda p S).newFrame x)‖ := by
  have hfactor := DFunLike.congr_fun
    (newFrameAntiresonantReadout_factorization data) x
  have hnorm := newFrameAntiresonantReadout_norm_le data
  simp only [ContinuousLinearMap.comp_apply] at hfactor
  rw [← hfactor]
  calc
    ‖newFrameAntiresonantReadout data
        (ContinuousLinearMap.adjoint (primeEulerAmbientLossFactor p)
          ((suffixEulerFrameSchurStep lambda p S).newFrame x))‖ ≤
      ‖newFrameAntiresonantReadout data‖ *
        ‖ContinuousLinearMap.adjoint (primeEulerAmbientLossFactor p)
          ((suffixEulerFrameSchurStep lambda p S).newFrame x)‖ :=
      (newFrameAntiresonantReadout data).le_opNorm _
    _ ≤ (2 * bound) *
        ‖ContinuousLinearMap.adjoint (primeEulerAmbientLossFactor p)
          ((suffixEulerFrameSchurStep lambda p S).newFrame x)‖ := by
      exact mul_le_mul_of_nonneg_right hnorm (norm_nonneg _)

end CCM24FiniteSCompletedJuliaRawPhysicalOldCarrierCoframeAntiresonantReduction
